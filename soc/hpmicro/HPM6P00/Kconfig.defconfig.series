if SOC_SERIES_HPM6P00

config SOC_SERIES
	default "HPM6P00"

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 24000000

config KERNEL_ENTRY
	default "_start"

config RISCV_GENERIC_TOOLCHAIN
	default y if "$(ZEPHYR_TOOLCHAIN_VARIANT)" = "zephyr"
	default n

config ICACHE
	default y

config DCACHE
	default y

config RISCV_SOC_INTERRUPT_INIT
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	default 12

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 127

config NUM_IRQS
	default 256

source "${ZEPHYR_SDK_GLUE_MODULE_DIR}/soc/hpmicro/HPM6P00/Kconfig.defconfig.HPM6P*"

endif # SOC_SERIES_HPM6P00
