	};

	pinmux_pdm: pinmux_pdm {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 10), IOC_TYPE_IOC, 0, 10)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 10), IOC_TYPE_PIOC, 0, 3)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 11), IOC_TYPE_IOC, 0, 10)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 11), IOC_TYPE_PIOC, 0, 3)>;
