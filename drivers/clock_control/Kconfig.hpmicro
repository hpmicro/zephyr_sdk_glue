config CLOCK_CONTROL_HPMICRO
	bool "HPMICRO clock control driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_CLOCK_ENABLED
    help
        Enable the HPMICRO PLL driver

config CLOCK_CONTROL_HPMICRO_PLLV1
	bool "HPMICRO clock control driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_PLL_CLOCK_ENABLED
    select HAS_HPMSDK_PLLCTL
    help
        Enable the HPMICRO PLL driver

config CLOCK_CONTROL_HPMICRO_PLLV2
	bool "HPMICRO clock control pllv2 driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_PLLV2_CLOCK_ENABLED
    select HAS_HPMSDK_PLLCTLV2
    help
        Enable the HPMICRO PLLV2 driver

config CLOCK_CONTROL_HPMICRO_CPU
	bool "HPMICRO CPU clock control driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_CPU_CLOCK_ENABLED
	help
	  Configure HPMicro CPU and derived system clocks from devicetree.

config CLOCK_CONTROL_HPMICRO_CPU_INIT_PRIORITY
	int "HPMICRO CPU clock initialization priority"
	default 41
	depends on CLOCK_CONTROL_HPMICRO_CPU
	help
	  Initialize the CPU clock after the PLL clock controllers and the
	  HPM6300 SoC voltage setup.
