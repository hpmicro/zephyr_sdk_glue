if BOARD_HPM6800EVK

config INIT_EXT_RAM
    bool "Initialize external RAM(SDRAM or DDR)"
    default y

choice
	prompt "DDR Type Selection"
	depends on INIT_EXT_RAM
	default DDR3L

config DDR2
    bool "DDR Type DDR2"

config DDR3L
    bool "DDR Type DDR3L"
endchoice

config HPMICRO_BOARD_SUPPORT_EMMC
    bool "SUPPORT EMMC"
    default n
    help
        SUPPORT EMMC

config HPMICRO_BOARD_SUPPORT_SD_DETECT
    bool "SUPPORT SD DETECT"
    default n
    help
        SUPPORT SD DETECT
endif #BOARD_HPM6800EVK
