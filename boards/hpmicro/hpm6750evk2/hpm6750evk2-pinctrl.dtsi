	};

	pinmux_dao: pinmux_dao {
		group0 {
			pinmux = <HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 8), IOC_TYPE_IOC, 0, 10)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 8), IOC_TYPE_PIOC, 0, 3)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 9), IOC_TYPE_IOC, 0, 10)>,
				<HPMICRO_PINMUX(HPMICRO_PIN(HPMICRO_PORTY, 9), IOC_TYPE_PIOC, 0, 3)>;
